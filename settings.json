const mineflayer = require('mineflayer');
const fs = require('fs');

// Load settings from settings.json
const settings = JSON.parse(fs.readFileSync('./settings.json', 'utf8'));

// Initialize Bot
const bot = mineflayer.createBot({
  host: settings.server.ip,
  port: settings.server.port,
  username: settings['bot-account'].username,
  password: settings['bot-account'].password || undefined,
  auth: settings['bot-account'].type === 'offline' ? 'offline' : 'mojang',
  version: settings.server.version || false
});

let messageIndex = 0;

// Handle Bot Spawn / Login Events
bot.on('spawn', () => {
  console.log(`[BOT] ${bot.username} connected to ${settings.server.ip}:${settings.server.port}`);

  // 1. Auto-Authentication (/login or /register)
  if (settings.utils['auto-auth'].enabled) {
    const pass = settings.utils['auto-auth'].password;
    setTimeout(() => {
      bot.chat(`/login ${pass}`);
      bot.chat(`/register ${pass} ${pass}`);
    }, 3000);
  }

  // 2. Anti-AFK Sneaking
  if (settings.utils['anti-afk'].enabled && settings.utils['anti-afk'].sneak) {
    bot.setControlState('sneak', true);
  }

  // 3. Periodic Broadcast Messages
  if (settings.utils['chat-messages'].enabled) {
    const messages = settings.utils['chat-messages'].messages;
    const delay = (settings.utils['chat-messages']['repeat-delay'] || 120) * 1000;

    setInterval(() => {
      if (messages.length > 0) {
        bot.chat(messages[messageIndex]);
        messageIndex = (messageIndex + 1) % messages.length;
      }
    }, delay);
  }

  // 4. Random Jump Anti-AFK
  if (settings.movement.enabled && settings.movement['random-jump'].enabled) {
    setInterval(() => {
      bot.setControlState('jump', true);
      setTimeout(() => bot.setControlState('jump', false), 500);
    }, settings.movement['random-jump'].interval || 10000);
  }
});

// Interactive Chatbot Handler
bot.on('chat', (username, message) => {
  if (username === bot.username) return; // Ignore self

  if (settings.utils['chat-log']) {
    console.log(`[CHAT] <${username}> ${message}`);
  }

  if (!settings.chat.respond) return;

  const msg = message.toLowerCase().trim();

  // Command Responses
  if (msg === '!help' || msg === '!cmds') {
    bot.chat(`@${username} Commands: !shop, !tpa, !home, !ah, !discord, !rules`);
  } 
  else if (msg === '!shop') {
    bot.chat(`@${username} Use /shop to buy items or /sellgui to sell quickly!`);
  } 
  else if (msg === '!tpa') {
    bot.chat(`@${username} Teleport commands: /tpa (name), /tpahere (name), /tpaccept`);
  } 
  else if (msg === '!home') {
    bot.chat(`@${username} Home commands: /sethome (name) and /home (name)`);
  } 
  else if (msg === '!ah') {
    bot.chat(`@${username} Auction House: /ah | Sell item: /ah sell <price> <quantity>`);
  } 
  else if (msg === '!lobby' || msg === '!hub') {
    bot.chat(`@${username} Return to lobby using /lobby or /hub`);
  } 
  else if (msg === '!media' || msg === '!role') {
    bot.chat(`@${username} Invite 15 people to get your free Media Role!`);
  } 
  else if (msg.includes('whatsapp') || msg === '!whatsapp') {
    bot.chat(`@${username} WhatsApp Link: ${settings.utils['chat-messages'].messages[13]}`);
  }
});

// Auto Reconnect Handler
bot.on('end', (reason) => {
  console.log(`[BOT] Disconnected: ${reason}`);
  if (settings.utils['auto-reconnect']) {
    const delay = settings.utils['auto-reconnect-delay'] || 2000;
    console.log(`[BOT] Reconnecting in ${delay / 1000} seconds...`);
    setTimeout(() => process.exit(1), delay); // Railway restarts process on exit
  }
});

bot.on('error', (err) => console.log('[ERROR]', err));
